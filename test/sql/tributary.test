# name: test/sql/tributary.test
# description: test tributary extension
# group: [tributary]

# Before we load the extension, this will fail
statement error
SELECT * from tributary_metadata("bootstrap.servers" := 'localhost:9092')
----
Catalog Error: Table Function with name tributary_metadata does not exist!

# Require statement will ensure this test is run with this extension loaded
require tributary

# The remaining statements need a live Kafka broker on localhost:9092. CI does
# not provision one, so they are skipped unless TRIBUTARY_TEST_KAFKA is set
# (any value); run locally with: TRIBUTARY_TEST_KAFKA=1 make test
require-env TRIBUTARY_TEST_KAFKA

# Confirm the extension works
query I
SELECT count(*) from tributary_metadata("bootstrap.servers" := 'localhost:9092')
----
1

